{
	"name": "n8n-nodes-nokfi",
	"version": "0.1.2",
	"description": "n8n nodes for Nokfi: extract and validate invoices, run financial analyses, Spanish tax tools (NIF, VAT, IRPF, Modelo 130, tax calendar) and a trigger for Nokfi events.",
	"license": "MIT",
	"homepage": "https://nokfi.app/api-docs",
	"keywords": [
		"n8n-community-node-package",
		"nokfi",
		"invoices",
		"invoice-extraction",
		"finance",
		"accounting",
		"spain",
		"tax",
		"vat",
		"webhook"
	],
	"author": {
		"name": "Nokfi",
		"email": "info@nokfi.app"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/m4r10-tech/n8n-nodes-nokfi.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/NokfiApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Nokfi/Nokfi.node.js",
			"dist/nodes/NokfiTrigger/NokfiTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}

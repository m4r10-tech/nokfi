      "notes": "Columns: fecha, concepto, entrada, salida, saldo (date, item, in, out, balance).",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://nokfi.app/api/v1/analyze",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'excel', lang: 'en', title: 'Weekly cash', data: { module: 'caja', files: [{ name: 'caja', rows: $input.all().map(i => i.json).slice(0, 5000), total_rows: $input.all().length }] } }) }}",
        "options": {}
      },
      "id": "b138230a-d9bb-593a-a5c2-25260a63bffa",
      "name": "Nokfi · Analyse cash",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "notes": "Credential: Bearer Auth with your nk_live_… key",
      "notesInFlow": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Short message with the summary and priorities of the Nokfi report.\nconst r = $json.report || {};\nconst top = (r.priorities || []).slice(0, 3).map(p => `• ${p.title}: ${p.detail}`);\nreturn [{ json: { text: [`Cash this week — ${$json.title || 'Nokfi'}`, '', r.summary || '', '', ...(top.length ? ['Priorities:', ...top] : [])].join('\\n') } }];"
      },
      "id": "769aa9b3-5b14-5dfb-9f1c-92e30af96dca",
      "name": "Prepare message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "",
        "text": "={{ $json.text }}",

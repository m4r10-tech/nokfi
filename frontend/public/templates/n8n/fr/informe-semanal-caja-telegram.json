    {
      "parameters": {
        "jsCode": "// Message court avec le résumé et les priorités du rapport Nokfi.\nconst r = $json.report || {};\nconst top = (r.priorities || []).slice(0, 3).map(p => `• ${p.title}: ${p.detail}`);\nreturn [{ json: { text: [`Trésorerie de la semaine — ${$json.title || 'Nokfi'}`, '', r.summary || '', '', ...(top.length ? ['Priorités :', ...top] : [])].join('\\n') } }];"

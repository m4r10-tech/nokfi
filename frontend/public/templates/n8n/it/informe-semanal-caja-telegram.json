    {
      "parameters": {
        "jsCode": "// Messaggio breve con il riepilogo e le priorità del report di Nokfi.\nconst r = $json.report || {};\nconst top = (r.priorities || []).slice(0, 3).map(p => `• ${p.title}: ${p.detail}`);\nreturn [{ json: { text: [`Cassa della settimana — ${$json.title || 'Nokfi'}`, '', r.summary || '', '', ...(top.length ? ['Priorità:', ...top] : [])].join('\\n') } }];"
      },

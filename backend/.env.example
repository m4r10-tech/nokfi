# ════════════════════════════════════════════════════════════
# Nokfi Backend — Variables de entorno
#
# CÓMO USAR ESTE ARCHIVO:
#   1. Copia este archivo y renómbralo a ".env" (sin el .example):
#        cp .env.example .env
#   2. Rellena cada valor vacío siguiendo las instrucciones de cada bloque
#   3. Nunca subas el archivo ".env" (ya renombrado) a GitHub ni lo compartas
#      por chat/email. El .gitignore ya está configurado para ignorarlo.
#   4. En el VPS, una vez relleno, ejecuta: chmod 600 .env
#      (esto hace que solo tu usuario pueda leer el archivo, nadie más)
# ════════════════════════════════════════════════════════════


# ── Servidor ──
# No requieren ninguna cuenta externa, son configuración propia.

PORT=3001
# Puerto donde arranca el backend. No lo cambies a menos que el 3001
# esté ocupado por otra cosa en tu VPS. Nginx redirige hacia este puerto.

NODE_ENV=production
# Déjalo en "production" en el VPS real. Solo se pone "development"
# si pruebas el backend en tu propio ordenador.


# ── Base de datos ──
# No requiere ninguna cuenta, SQLite crea el archivo solo la primera vez.

DB_PATH=./db/nokfi.db
# Ruta donde se guardará el archivo de base de datos. No lo toques
# salvo que sepas lo que haces.


# ── Seguridad: contraseña del panel admin ──

ADMIN_SECRET=
# Esta es la "contraseña" para entrar al panel de administración.
# NO la consigues en ningún sitio web — la INVENTAS tú mismo.
# Para generar una segura y aleatoria, ejecuta este comando en tu terminal:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Copia el resultado (una cadena larga de letras y números) y pégalo aquí.
# Guárdala también en un gestor de contraseñas — si la pierdes, no hay
# forma de recuperarla, solo de generar una nueva y volver a desplegar.


# ── Dominios permitidos (CORS) ──

ALLOWED_ORIGINS=https://nokfi.app
# Lista de las webs desde las que se permite llamar a este backend,
# separadas por coma SIN espacios. Sustituye "nokfi.app" por vuestro
# dominio real una vez lo compréis (sección 17 del proyecto).
# Mientras pruebes en tu ordenador, puedes poner: http://localhost:5173
#
# ⚠️ AUDITORÍA DE SEGURIDAD: el comodín "*" (permitir cualquier origen)
# SOLO funciona si NODE_ENV no es "production" — en producción el
# servidor se niega a arrancar si detecta ALLOWED_ORIGINS="*", para
# evitar que un despliegue real quede con CORS abierto a cualquier web
# por descuido. Si tu VPS tiene NODE_ENV=production, pon aquí el dominio
# o IP real desde donde sirves el frontend (ej. http://TU_IP:5173 o
# https://nokfi.app), nunca "*".


# ── URLs públicas (se usan dentro de los emails y en las redirecciones de pago) ──

APP_PUBLIC_URL=https://nokfi.app
# La URL única donde vive Nokfi (dominio único nokfi.app; el backend se
# sirve en el mismo origen vía Nginx /api → :3001).

LANDING_PUBLIC_URL=https://nokfi.app
# La URL de la página de venta pública (mismo dominio que APP_PUBLIC_URL).


# ── Precio de los planes (suscripción mensual, en EUR) ──
# Fases 3+ : modelo de suscripción mini/pro/max. El precio lo define el operador
# aquí; al reiniciar el backend se mueve a la vez lo que cobra Stripe (unit_amount)
# y lo que muestra la web (GET /api/payments/plans). Así nunca cobráis un precio y
# mostráis otro. Defaults si se deja vacío o inválido: 5 / 20 / 50 €.

PLAN_PRICE_MINI_EUR=5
PLAN_PRICE_PRO_EUR=20
PLAN_PRICE_MAX_EUR=50
# €/mes cobrados por Stripe (suscripción recurrente). Solo mini lleva trial de
# 14 días con tarjeta (fijo en config/plans.js TRIAL_PLANS). La cuota de análisis
# IA/día (10/50/130) NO va aquí — es decisión de producto, ver PLAN_QUOTAS en
# backend/config/plans.js.


# ════════════════════════════════════════════════════════════
# IA — proveedores en cadena (sesión 7)
# ════════════════════════════════════════════════════════════
# Se prueban en orden: si uno falla o no tiene clave, pasa al siguiente.
# Solo proveedores que NO entrenan con los datos de los clientes.
AI_PROVIDERS=groq,cloudflare,cerebras        # análisis e informes
CHAT_PROVIDERS=groq,cloudflare,cerebras      # asistente (chat)

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b           # facturas en foto / PDF escaneado

# Cloudflare Workers AI — token con permiso "Workers AI"
CF_ACCOUNT_ID=
CF_AI_TOKEN=
CF_AI_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
CF_AI_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Cerebras — respaldo con tope de gasto (utils/aiBudget.js)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_VISION_MODEL=qwen-3.8-27b
# Topes y caducidad por proveedor: AI_BUDGET_<PROV>_DAILY_TOKENS,
# AI_BUDGET_<PROV>_MONTHLY_USD y AI_EXPIRES_<PROV>=YYYY-MM-DD (desde ese día
# el proveedor deja de usarse solo).
AI_BUDGET_CEREBRAS_DAILY_TOKENS=
AI_EXPIRES_CEREBRAS=

# Opcionales (no están en la cadena por defecto). Gemini gratis SÍ entrena con
# los datos: no usarlo en producción.
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Límites de uso
CHAT_PER_MINUTE=10            # mensajes de chat por licencia y minuto
API_RATE_PER_MINUTE=30        # llamadas a /api/v1 por clave y minuto


# ════════════════════════════════════════════════════════════
# API pública, webhooks y operación
# ════════════════════════════════════════════════════════════
# Solo para pruebas locales: permitir webhooks a http:// y a IPs privadas.
# En producción, vacíos (se bloquea SSRF).
WEBHOOKS_ALLOW_HTTP=
WEBHOOKS_ALLOW_PRIVATE=

OPS_EMAIL=admin@nokfi.app     # informe diario de operación

# Copia de la BD fuera del VPS (Cloudflare R2), opcional: si R2_BUCKET está
# vacío, backup-db.sh solo guarda la copia local.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_JURISDICTION=eu
BACKUP_ENCRYPTION_KEY=        # openssl rand -hex 32 (guárdala fuera del VPS)


# ════════════════════════════════════════════════════════════
# Email transaccional — Resend (único proveedor)
# ════════════════════════════════════════════════════════════

EMAIL_FROM=no-reply@nokfi.app
# La dirección que aparecerá como remitente. Tiene que ser de un dominio
# que verifiques en Resend (ver instrucciones abajo).

EMAIL_FROM_NAME=Nokfi
# El nombre que verá el destinatario junto al email (ej. "Nokfi <no-reply@nokfi.app>")

# CÓMO CONSEGUIR LA CLAVE DE RESEND:
#   1. Entra en https://resend.com/ y crea una cuenta gratuita
#      (incluye 3.000 emails/mes gratis)
#   2. Ve a Domains y añade/verifica vuestro dominio (nokfi.app)
#   3. Ve a API Keys → Create API Key
#   4. Copia la clave y pégala abajo

RESEND_API_KEY=


# ════════════════════════════════════════════════════════════
# Pagos — Stripe
# ════════════════════════════════════════════════════════════
# CÓMO CONSEGUIR LAS CLAVES:
#   1. Entra en https://dashboard.stripe.com/register y crea una cuenta
#      (te pedirá datos personales/de empresa y datos bancarios para
#      poder cobrar de verdad — puedes rellenarlo más tarde y probar
#      primero en modo "test")
#   2. Una vez dentro del Dashboard, arriba a la derecha hay un toggle
#      "Test mode" / modo real — empieza siempre en modo Test
#   3. Ve a Developers → API keys
#   4. Copia la "Secret key" (empieza por sk_test_... en modo prueba,
#      o sk_live_... en modo real) y pégala en STRIPE_SECRET_KEY
#   5. Para el webhook secret: ve a Developers → Webhooks → Add endpoint
#      - URL del endpoint: https://nokfi.app/api/webhooks/stripe
#      - Eventos a escuchar: "checkout.session.completed" y
#        "charge.dispute.created"
#      - Tras crearlo, Stripe te mostrará un "Signing secret" que
#        empieza por whsec_... — pégalo en STRIPE_WEBHOOK_SECRET

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Un Price recurrente mensual (EUR) por plan, de 3 Products separados (price_...).
STRIPE_PRICE_MINI=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=


# ── VERI*FACTU (sesión 11) ──────────────────────────────────────────
# Los registros de alta/anulación con huella encadenada se generan SIEMPRE.
# Esto solo controla el envío a la AEAT y el QR tributario del PDF.
#   VERIFACTU_ENV: off (por defecto) | test (preproducción AEAT) | prod
#   prod exige además VERIFACTU_PROD_ENABLED=1 (sin él se queda en off).
#   VERIFACTU_LICENSES: licencias que envían ("6,12" o "*"); vacío = ninguna.
#   Certificado electrónico (.p12/.pfx) del obligado o de su representante.
VERIFACTU_ENV=off
VERIFACTU_PROD_ENABLED=
VERIFACTU_LICENSES=
VERIFACTU_CERT_PATH=
VERIFACTU_CERT_PASSWORD=
# Productor del sistema informático (declaración responsable): nombre y NIF.
VERIFACTU_PRODUCER_NAME=Nokfi
VERIFACTU_PRODUCER_NIF=
